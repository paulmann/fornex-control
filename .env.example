# ---------------------------------------------------------------------------
# Fornex Control — application configuration.
#
# Copy this file to `fornex.env` ONE LEVEL ABOVE the application directory
# (best: outside the web root) or to `.env` inside it, then fill in the values.
#
#   <root>/fornex-control/   application
#   <root>/fornex.env        configuration (chmod 640, owner = web user)
#
# The file is never committed: .gitignore excludes `.env` and `*.env`.
# ---------------------------------------------------------------------------

# Application
APP_NAME="Fornex Control"
APP_ENV=production          # production | development
APP_VERSION=1.1.0
APP_URL=https://panel.example.com/
APP_BASE=                   # URL sub-path when the app is not in the site root, e.g. /fornex
APP_TIMEZONE=UTC

# Fornex Public API key (ru.fornex.com → "My" → API). Never printed, never logged.
FORNEX_API_KEY=
FORNEX_BASE_URL=https://ru.fornex.com/api
FORNEX_TIMEOUT=30           # seconds per HTTP request
FORNEX_RETRIES=2            # retries for network and 5xx errors only
FORNEX_DEFAULT_IP=          # pre-filled IP for the "site on VPS" / "mail on VPS" presets

# Panel login. The hash is produced with:
#   php -r "echo password_hash('your-password', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=

# Password-less entry from a trusted address (empty = disabled).
# Use only on a network you control: the address alone grants write access.
AUTO_LOGIN_IP=

# Local state: SQLite database, log, zone snapshots. Relative paths are resolved
# from the application root; absolute paths are used as given.
DB_PATH=var/fornex.sqlite
LOG_PATH=var/log/app.log
LOG_LEVEL=info               # debug | info | warning | error
SNAPSHOT_DIR=var/snapshots

# Session
SESSION_NAME=fnx_session
SESSION_IDLE=1800            # seconds of inactivity before logout
SESSION_SECURE=1             # 1 = cookie only over HTTPS (production)

# DNS verification: public resolver plus Fornex's own authoritative server.
VERIFY_RESOLVER=8.8.8.8
VERIFY_AUTHORITATIVE=ns1.fornex.com
